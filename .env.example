# --- Database ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DBNAME
# Dedicated database for pytest (dropped and recreated on each run)
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DBNAME_test
# --- Backend ---
SECRET_KEY=
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
# --- Frontend ---
# Server-side only: target of the /api/v1 rewrite and of server-rendered session checks
BACKEND_URL=http://localhost:8000
