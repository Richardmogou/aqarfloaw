# --- Database ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DBNAME
# Dedicated database for pytest (dropped and recreated on each run)
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DBNAME_test
# --- Backend ---
SECRET_KEY=
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
# Property photos directory (relative to backend/ locally; /app/uploads in the Docker image)
MEDIA_ROOT=uploads
# --- Object storage (S3-compatible; MinIO in docker-compose) ---
# local = files under MEDIA_ROOT (tests, quick dev); s3 = private bucket, images served through the API
STORAGE_BACKEND=s3
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# From the host: http://localhost:9000. Inside docker-compose the backend uses http://minio:9000.
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=aqarflow-media
# --- Frontend ---
# Server-side only: target of the /api/v1 rewrite and of server-rendered session checks
BACKEND_URL=http://localhost:8000
